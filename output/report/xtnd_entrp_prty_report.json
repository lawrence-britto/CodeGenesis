  "generated_sql": "SELECT\n'RBC~VN~C_PRTY~XTND_ENTRP_PRTY~1' AS PROCESS_ID,\nPRTY.DATA_SRC AS DATA_SRC,\nPRTY.SOURCE_COUNTRY_CODE AS SOURCE_COUNTRY_CODE,\nCPI.PRTY_SROGT_ID AS S_ENTRP_PRTY,\nPRTY.DOM_PRTY_REF AS N_ENTRP_PRTY,\nPRTY.DOM_PRTY AS N_CORE_PRTY,\nPRTY.ACCS_SEGMT_CD AS ACCS_SEGMT_CD,\nPRTY.ACCS_CTRY_CD AS ACCS_CTRY_CD,\nEC_ACCT_EPR.TO_BALA_LCY AS A_TO_LCY,\nEC_ACCT_EPR.CASA_BALA_SCY AS A_CASA_SCY,\nUPPER(CPI.ID_REF) AS N_CUST\nFROM (SELECT ACCS_CTRY_CD, ACCS_SEGMT_CD, DATA_SRC, DOM_PRTY, DOM_PRTY_REF, PRTY_SROGT_ID, SOURCE_COUNTRY_CODE FROM C_PRTY\n    WHERE DATA_SRC = 'EBB'\n   AND SOURCE_COUNTRY_CODE = 'VN'\n) PRTY\n\nLEFT JOIN (\n    SELECT PRTY_SROGT_ID, ID_REF\n    FROM C_PRTY_ID\n    WHERE DATA_SRC = 'EBB'\n   AND SOURCE_COUNTRY_CODE = 'VN'\n   AND ID_TP_CD = 'N01'\n) CPI\n    ON PRTY.PRTY_SROGT_ID = CPI.PRTY_SROGT_ID\n\nLEFT JOIN (SELECT CASA_BALA_SCY, ENTRP_PRTY_SROGT_ID, TO_BALA_LCY FROM E_CORE_ACCT_EPRTY_ROLLUP\n    WHERE DATA_SRC = 'EBB'\n   AND SOURCE_COUNTRY_CODE = 'VN'\n) EC_ACCT_EPR\n    ON TRIM(PRTY.PRTY_SROGT_ID) = TRIM(EC_ACCT_EPR.ENTRP_PRTY_SROGT_ID);",
